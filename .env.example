# Copy to .env (never commit it).
BRIDGE_SECRETS=                 # one or two long random values, comma separated (mc-bridge new-secret); ManyChat sends one in X-Bridge-Secret
ANTHROPIC_API_KEY=              # the client's own key, in a workspace with a monthly spend limit
MANYCHAT_API_KEY=               # optional: ManyChat Settings > API (paid plans). Enables the slow path and extra actions
ALERT_WEBHOOK_URL=              # optional: Slack/Teams/n8n URL for failure, handover and empty-run alerts
HEARTBEAT_URL=                  # optional: Healthchecks.io ping URL (dead-man's switch)
AI_DISCLOSURE=                  # optional custom AI disclosure line (blank = default)
AI_DISCLOSURE_REMOVED_BY_WRITTEN_REQUEST=  # only with the client's written request (date, who)
KILL_SWITCH=                    # true = no AI calls at all
TRUST_PROXY_HEADERS=            # true behind Render/Cloudflare, so per-IP limits see the real caller
